{
  "name": "@product-ad-studio/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/validate.mjs && node scripts/render.mjs --mode sample",
    "render": "node scripts/validate.mjs && node scripts/render.mjs --mode render --scale 1",
    "poster": "node scripts/validate.mjs && node scripts/render.mjs --mode still --frame 300 --scale 0.5",
    "test": "node --test scripts/validate.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
